# Copy to .env and change the values. .env is git-ignored.

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=text            # text | json

# PostgreSQL (the container is published on 127.0.0.1:5442 only)
POSTGRES_USER=fuelguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fuelguard
DATABASE_URL_ASYNC=postgresql+asyncpg://fuelguard:change-me@db:5432/fuelguard
DATABASE_URL_SYNC=postgresql+psycopg2://fuelguard:change-me@db:5432/fuelguard

# Redis (published on 127.0.0.1:6380 only)
REDIS_URL=redis://redis:6379/0

# API keys: managers use X-Manager-Key, card terminals use X-Terminal-Key
MANAGER_API_KEY=change-me-manager-key
TERMINAL_API_KEY=change-me-terminal-key

# Risk rules
FREQUENCY_MAX_PURCHASES=3
FREQUENCY_WINDOW_MINUTES=30
LARGE_PURCHASE_MULTIPLIER=2.0
LARGE_PURCHASE_MIN_HISTORY=5
LARGE_PURCHASE_FALLBACK_TANK_RATIO=0.8

# Background jobs
ANALYSIS_MAX_RETRIES=5
STUCK_AFTER_MINUTES=5
RECOVERY_INTERVAL_SECONDS=120
