# Copy to .env and change the values. .env is git-ignored.

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=text            # text | json

# PostgreSQL (the container is published on 127.0.0.1:5442 only)
POSTGRES_USER=fuelguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fuelguard
DATABASE_URL_ASYNC=postgresql+asyncpg://fuelguard:change-me@db:5432/fuelguard
DATABASE_URL_SYNC=postgresql+psycopg2://fuelguard:change-me@db:5432/fuelguard

# Redis (published on 127.0.0.1:6380 only)
REDIS_URL=redis://redis:6379/0

# Keycloak: the OAuth2 / OpenID Connect identity provider (published on 127.0.0.1:8180 only).
# The admin console is at http://localhost:8180 (user "admin").
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
# Demo accounts created in Keycloak from keycloak/fuelguard-realm.json:
#   user "manager" (full access), user "auditor" (read-only), client "fuelguard-terminal" (purchases only)
MANAGER_PASSWORD=change-me-manager
AUDITOR_PASSWORD=change-me-auditor
TERMINAL_CLIENT_SECRET=change-me-terminal-secret

# The address callers use to reach Keycloak. It must equal the "iss" claim in the tokens.
OIDC_ISSUER=http://localhost:8180/realms/fuelguard
# Where the API container fetches the token signing keys (Keycloak's address inside Docker).
OIDC_JWKS_URL=http://keycloak:8080/realms/fuelguard/protocol/openid-connect/certs
# Tokens must be meant for this API.
OIDC_AUDIENCE=fuelguard-api

# Risk rules
FREQUENCY_MAX_PURCHASES=3
FREQUENCY_WINDOW_MINUTES=30
LARGE_PURCHASE_MULTIPLIER=2.0
LARGE_PURCHASE_MIN_HISTORY=5
LARGE_PURCHASE_FALLBACK_TANK_RATIO=0.8

# Background jobs
ANALYSIS_MAX_RETRIES=5
STUCK_AFTER_MINUTES=5
RECOVERY_INTERVAL_SECONDS=120
